rules_version = '2';

/**
 * REGLAS DE SEGURIDAD DE CLOUD FIRESTORE — BLACK CAT NAILS
 *
 * La app valida todo antes de escribir, pero una app se puede modificar; estas
 * reglas son la barrera real en el servidor. Principios:
 *  - Cada clienta solo lee y escribe lo suyo (perfil, citas, favoritos, historial).
 *  - Nadie puede asignarse el rol de administradora ni tocar su contador de inasistencias.
 *  - La disponibilidad se publica en agendaDias sin datos personales.
 *  - El historial de actividad es inmutable: se puede agregar, nunca editar ni borrar.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- utilidades ----------
    function autenticada() {
      return request.auth != null;
    }
    function esYo(uid) {
      return autenticada() && request.auth.uid == uid;
    }
    function rutaUsuaria(uid) {
      return /databases/$(database)/documents/usuarias/$(uid);
    }
    function esAdmin() {
      return autenticada()
        && exists(rutaUsuaria(request.auth.uid))
        && get(rutaUsuaria(request.auth.uid)).data.rol == 'admin';
    }
    function cambiaSolo(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    function correoDeLaSesion() {
      return request.auth.token.email.lower();
    }
    function telefonoValido(t) {
      return t is string && t.matches('^[0-9]{8}$');
    }

    // ---------- usuarias ----------
    function perfilNuevoValido(uid) {
      let d = request.resource.data;
      return d.keys().hasAll(['nombre', 'correo', 'telefono', 'rol', 'inasistencias', 'codigoReferido', 'creadaEn'])
        && d.keys().hasOnly(['nombre', 'correo', 'telefono', 'rol', 'inasistencias', 'codigoReferido',
                             'referidaPor', 'proveedor', 'creadaEn', 'actualizadaEn', 'fotoUri'])
        && d.rol == 'clienta'
        && d.inasistencias == 0
        && d.nombre is string && d.nombre.size() >= 3 && d.nombre.size() <= 60
        && telefonoValido(d.telefono)
        && d.correo == correoDeLaSesion()
        // El código propio se reserva en la misma escritura atómica (batch).
        && getAfter(/databases/$(database)/documents/codigosReferido/$(d.codigoReferido)).data.uid == uid
        && (!('referidaPor' in d)
            || exists(/databases/$(database)/documents/codigosReferido/$(d.referidaPor)));
    }

    function cambioPropioValido() {
      let d = request.resource.data;
      let cambios = d.diff(resource.data).affectedKeys();
      return cambiaSolo(['telefono', 'correo', 'fotoUri', 'actualizadaEn'])
        && (!cambios.hasAny(['telefono']) || telefonoValido(d.telefono))
        // El correo solo cambia para reflejar el de Firebase Auth (ya verificado).
        && (!cambios.hasAny(['correo']) || d.correo == correoDeLaSesion())
        && (!cambios.hasAny(['fotoUri']) || (d.fotoUri is string && d.fotoUri.size() < 300000));
    }

    function actividadValida() {
      let d = request.resource.data;
      return d.keys().hasAll(['tipo', 'descripcion', 'fecha'])
        && d.keys().hasOnly(['tipo', 'descripcion', 'fecha', 'citaId'])
        && d.tipo in ['registro', 'inicio_sesion', 'cita_creada', 'cita_cancelada', 'cita_estado',
                      'perfil_actualizado', 'foto_actualizada', 'favorito_agregado']
        && d.descripcion is string && d.descripcion.size() <= 200
        && d.fecha == request.time; // serverTimestamp(): la fecha no se puede falsear
    }

    match /usuarias/{uid} {
      allow read: if esYo(uid) || esAdmin();
      allow create: if esYo(uid) && perfilNuevoValido(uid);
      allow update: if (esYo(uid) && cambioPropioValido()) || esAdmin();
      allow delete: if false;

      match /favoritos/{disenoId} {
        allow read, delete: if esYo(uid);
        allow create, update: if esYo(uid)
          && request.resource.data.keys().hasOnly(['nombre', 'creadoEn'])
          && request.resource.data.nombre is string;
      }

      match /actividad/{registroId} {
        allow read: if esYo(uid) || esAdmin();
        allow create: if (esYo(uid) || esAdmin()) && actividadValida();
        allow update, delete: if false;
      }
    }

    // ---------- referidos ----------
    match /codigosReferido/{codigo} {
      // get sin sesión: el registro valida el código de la amiga antes de crear la cuenta.
      allow get: if true;
      allow list: if false;
      allow create: if autenticada()
        && codigo.matches('^[A-Z]{3,6}[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(rutaUsuaria(request.auth.uid)).data.codigoReferido == codigo;
      allow update, delete: if false;
    }

    match /referidos/{uid} {
      // La referente ve el nombre de quienes usaron su código, nada más.
      allow read: if esAdmin()
        || (autenticada() && resource.data.codigoReferente == get(rutaUsuaria(request.auth.uid)).data.codigoReferido);
      allow create: if esYo(uid)
        && request.resource.data.keys().hasOnly(['codigoReferente', 'nombre', 'creadaEn'])
        && request.resource.data.codigoReferente == getAfter(rutaUsuaria(uid)).data.referidaPor;
      allow update, delete: if false;
    }

    // ---------- catálogo e inventario ----------
    match /servicios/{servicioId} {
      allow read: if autenticada();
      allow write: if esAdmin();
    }

    match /insumos/{insumoId} {
      allow read, write: if esAdmin();
    }

    // ---------- citas ----------
    function citaNuevaValida(citaId) {
      let d = request.resource.data;
      return d.clientaId == request.auth.uid
        && d.estado == 'confirmada'
        && d.inicioMs is int && d.inicioMs > request.time.toMillis()
        && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.servicios is list && d.servicios.size() > 0 && d.servicios.size() <= 6
        && d.montoTotal is number && d.montoTotal > 0
        && (!('notas' in d) || (d.notas is string && d.notas.size() <= 300))
        && (!('imagenReferenciaUri' in d) || (d.imagenReferenciaUri is string && d.imagenReferenciaUri.size() < 600000))
        && !d.keys().hasAny(['insumosDescontados', 'montoCobrado', 'fechaRetoque'])
        // La cita tiene que ocupar su bloque en la agenda del día en la misma transacción.
        && getAfter(/databases/$(database)/documents/agendaDias/$(d.fecha)).data.bloques[citaId].uid == request.auth.uid;
    }

    function cancelacionPropia() {
      return autenticada()
        && resource.data.clientaId == request.auth.uid
        && resource.data.estado in ['solicitada', 'confirmada']
        && request.resource.data.estado == 'cancelada'
        && cambiaSolo(['estado', 'actualizadaEn'])
        // Regla de negocio: cancelar desde la app solo con 12 horas de anticipación.
        && resource.data.inicioMs - request.time.toMillis() >= 12 * 60 * 60 * 1000;
    }

    match /citas/{citaId} {
      allow read: if esAdmin() || (autenticada() && resource.data.clientaId == request.auth.uid);
      allow create: if autenticada() && citaNuevaValida(citaId);
      allow update: if esAdmin() || cancelacionPropia();
      allow delete: if false;
    }

    // ---------- disponibilidad (sin datos personales) ----------
    function diaValido(fecha) {
      let d = request.resource.data;
      return d.keys().hasOnly(['fecha', 'bloques', 'ultimaCita']) && d.fecha == fecha && d.bloques is map;
    }

    function agregaBloquePropio(fecha, antes) {
      let d = request.resource.data;
      let id = d.ultimaCita;
      return diaValido(fecha)
        && !(id in antes)
        && d.bloques.diff(antes).affectedKeys().hasOnly([id])
        && d.bloques[id].keys().hasOnly(['inicio', 'fin', 'uid'])
        && d.bloques[id].uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/citas/$(id)).data.clientaId == request.auth.uid;
    }

    function liberaBloquePropio(fecha) {
      let d = request.resource.data;
      let id = d.ultimaCita;
      let antes = resource.data.bloques;
      return diaValido(fecha)
        && id in antes
        && !(id in d.bloques)
        && d.bloques.diff(antes).affectedKeys().hasOnly([id])
        && antes[id].uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/citas/$(id)).data.estado == 'cancelada';
    }

    match /agendaDias/{fecha} {
      allow read: if autenticada();
      allow create: if esAdmin() || (autenticada() && agregaBloquePropio(fecha, {}));
      allow update: if esAdmin()
        || (autenticada() && (agregaBloquePropio(fecha, resource.data.bloques) || liberaBloquePropio(fecha)));
      allow delete: if false;
    }
  }
}
