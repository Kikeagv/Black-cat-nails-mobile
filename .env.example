# Copiá este archivo como .env y completalo con los datos de tu proyecto.
# Consola de Firebase → Configuración del proyecto → Tus apps → App web (</>).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In
# Web client ID: Authentication → Sign-in method → Google → Configuración del SDK web.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID: CLIENT_ID del archivo GoogleService-Info.plist de la app iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Esquema de URL inverso (REVERSED_CLIENT_ID del mismo .plist). Lo usa app.config.ts.
GOOGLE_IOS_URL_SCHEME=

# Desarrollo local con el Firebase Emulator Suite (npm run emuladores)
EXPO_PUBLIC_USAR_EMULADORES=0
